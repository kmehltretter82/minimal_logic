import Proofs.Schwichtenberg1976V2.Reduction

/-!
# Clauses (1)–(3) evaluate to polynomials (p. 114, lines 14–22)

Substitute the Church numerals `v̄ᵢ` (all `vᵢ ≠ 0`) for the variables `Fᵢ` in a term `s`
generated by clauses (1)–(3). Then `s` reduces either to `α` itself, or to `λy. α^{P(v)} z`
for a polynomial `P`.

The induction proves a sharper classification, fixed once for all `v`:

* *bound*: `s` reduces to `λz₀. α^{P(v)} z₀`, so `s` acts as `α^{P(v)}`;
* *constant*: `s` reduces to `λy. α^{P(v)} w` with `y ≠ w` and `w` free in `s`, a constant map.

This is needed because a numeral `n̄` iterates `s`. A bound `s` iterated `n` times gives
`α^{n·P(v)}`, while a constant `s` iterated `n ≥ 1` times stays the same constant.
-/

namespace Schwichtenberg1976V2.Proofs

open Schwichtenberg1976V2

/-- The substitution `Fᵢ ↦ v̄ᵢ` used in the lemma. -/
def numSubst {k : Nat} (Fs : Fin k → Var) (v : Fin k → Nat) : List (Var × Term) :=
  (List.finRange k).map (fun i => (Fs i, churchNumeral (v i)))

/-- The canonical binder of type `0` used for the bound case. -/
def z0 : Var := ⟨0, .zero⟩

section

variable {k : Nat} (Fs : Fin k → Var) (α : Var)

/-- Classification of a term generated by clauses (1)–(3). -/
def Classified (s : Term) : Prop :=
  s = .var α ∨
  (∃ P : (Fin k → Nat) → Nat, IsPolynomial P ∧
    ∀ v : Fin k → Nat, (∀ i, v i ≠ 0) →
      ReducesTo (substMany s (numSubst Fs v)) (.lam z0 (iterApp (.var α) (.var z0) (P v)))) ∨
  (∃ (P : (Fin k → Nat) → Nat) (w : Var), IsPolynomial P ∧ w.ty = .zero ∧
    w ∈ freeVarOccurrences s ∧
    ∀ v : Fin k → Nat, (∀ i, v i ≠ 0) →
      ∃ y : Var, y.ty = .zero ∧ y ≠ w ∧
        ReducesTo (substMany s (numSubst Fs v)) (.lam y (iterApp (.var α) (.var w) (P v))))

/-- Classification of a chain `s₁(…(s_q z)…)`: it reduces to `α^{P(v)} w`. -/
def ChainClassified (body : Term) : Prop :=
  ∃ (P : (Fin k → Nat) → Nat) (w : Var), IsPolynomial P ∧ w.ty = .zero ∧
    w ∈ freeVarOccurrences body ∧
    ∀ v : Fin k → Nat, (∀ i, v i ≠ 0) →
      ReducesTo (substMany body (numSubst Fs v)) (iterApp (.var α) (.var w) (P v))

end

variable {k : Nat} {Fs : Fin k → Var} {α : Var}

theorem numSubst_spec (hFs_ty : ∀ i, (Fs i).ty = Ty.nu) (v : Fin k → Nat) :
    ∀ p ∈ numSubst Fs v, p.1.ty = Ty.nu ∧ freeVarOccurrences p.2 = [] := by
  intro p hp
  simp only [numSubst, List.mem_map] at hp
  obtain ⟨i, _, rfl⟩ := hp
  exact ⟨hFs_ty i, fvo_churchNumeral _⟩

theorem numSubst_var (hFs_ty : ∀ i, (Fs i).ty = Ty.nu) (v : Fin k → Nat) {x : Var}
    (hx : x.ty ≠ Ty.nu) : substMany (.var x) (numSubst Fs v) = .var x :=
  substMany_var_of_not_key x _ fun p hp h => hx (h ▸ (numSubst_spec hFs_ty v p hp).1)

theorem numSubst_lam (hFs_ty : ∀ i, (Fs i).ty = Ty.nu) (v : Fin k → Nat) {y : Var}
    (hy : y.ty = .zero) (b : Term) :
    substMany (.lam y b) (numSubst Fs v) = .lam y (substMany b (numSubst Fs v)) := by
  refine substMany_lam y b _ fun p hp => ⟨fun h => ?_, (numSubst_spec hFs_ty v p hp).2⟩
  have := (numSubst_spec hFs_ty v p hp).1
  rw [h, hy] at this
  cases this

theorem numSubst_F (hFs_inj : Function.Injective Fs) (v : Fin k → Nat) (i : Fin k) :
    substMany (.var (Fs i)) (numSubst Fs v) = churchNumeral (v i) := by
  have := substMany_var_index Fs hFs_inj (fun j => churchNumeral (v j))
    (fun j => fvo_churchNumeral _) i (List.finRange k)
  rw [if_pos (List.mem_finRange i)] at this
  exact this

theorem ty_endo_ne_nu : Ty.endo ≠ Ty.nu := by decide
theorem ty_zero_ne_nu : Ty.zero ≠ Ty.nu := by decide

theorem var_ne_of_ty {a b : Var} (h : a.ty ≠ b.ty) : a ≠ b := fun e => h (e ▸ rfl)

mutual

theorem type00_classified (hFs_ty : ∀ i, (Fs i).ty = Ty.nu)
    (hFs_inj : Function.Injective Fs) (hα_ty : α.ty = Ty.endo) :
    ∀ {s : Term}, IsType00Subterm (List.ofFn Fs) α s → Classified Fs α s
  | _, .basic hb => basic_classified hFs_ty hFs_inj hα_ty hb
  | _, .chainLam y z hy _ hc => by
      obtain ⟨P, w, hP, hwty, hwmem, hred⟩ := chain_classified hFs_ty hFs_inj hα_ty hc
      have hαy : α ≠ y := var_ne_of_ty (by rw [hα_ty, hy]; decide)
      by_cases hwy : w = y
      · subst hwy
        refine Or.inr (Or.inl ⟨P, hP, fun v hv => ?_⟩)
        rw [numSubst_lam hFs_ty v hy]
        refine .trans (.lam w (hred v hv)) (.refl_alpha ?_)
        exact alpha_lam_iterApp _ (by rw [hy]; rfl) hαy
          (var_ne_of_ty (by rw [hα_ty]; decide))
      · refine Or.inr (Or.inr ⟨P, w, hP, hwty, (mem_fvo_lam y _ w).2 ⟨hwmem, hwy⟩,
          fun v hv => ⟨y, hy, fun h => hwy h.symm, ?_⟩⟩)
        rw [numSubst_lam hFs_ty v hy]
        exact .lam y (hred v hv)

theorem basic_classified (hFs_ty : ∀ i, (Fs i).ty = Ty.nu)
    (hFs_inj : Function.Injective Fs) (hα_ty : α.ty = Ty.endo) :
    ∀ {s : Term}, IsBasicType00 (List.ofFn Fs) α s → Classified Fs α s
  | _, .alpha => Or.inl rfl
  | _, @IsBasicType00.appF _ _ F s' hF hs => by
      obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hF
      have hαz0 : α ≠ z0 := var_ne_of_ty (by rw [hα_ty]; decide)
      have happ : ∀ v, substMany (.app (.var (Fs i)) s') (numSubst Fs v) =
          .app (churchNumeral (v i)) (substMany s' (numSubst Fs v)) := by
        intro v
        rw [substMany_app, numSubst_F hFs_inj]
      rcases type00_classified hFs_ty hFs_inj hα_ty hs with rfl | ⟨Q, hQ, hred⟩ |
          ⟨Q, w, hQ, hwty, hwmem, hred⟩
      · -- `Fᵢ α` acts as `α^{vᵢ}`
        refine Or.inr (Or.inl ⟨fun v => v i, .proj i, fun v _ => ?_⟩)
        rw [happ, numSubst_var hFs_ty v (by rw [hα_ty]; exact ty_endo_ne_nu)]
        obtain ⟨u, hu, _, hr⟩ := numeral_app (v i) (.var α)
        exact .trans hr (.refl_alpha (alpha_lam_iterApp _ (by rw [hu]; rfl)
          (var_ne_of_ty (by rw [hα_ty, hu]; decide)) hαz0))
      · -- bound: `Fᵢ s'` acts as `α^{vᵢ · Q(v)}`
        refine Or.inr (Or.inl ⟨fun v => v i * Q v, .mul (.proj i) hQ, fun v hv => ?_⟩)
        rw [happ]
        obtain ⟨u, hu, _, hr⟩ :=
          numeral_app (v i) (.lam z0 (iterApp (.var α) (.var z0) (Q v)))
        refine .trans (.app (ReducesTo.rfl' _) (hred v hv)) (.trans hr ?_)
        refine .trans (.lam u (iter_bound (Q v) hαz0 (.var u) (v i))) (.refl_alpha ?_)
        exact alpha_lam_iterApp _ (by rw [hu]; rfl)
          (var_ne_of_ty (by rw [hα_ty, hu]; decide)) hαz0
      · -- constant: `Fᵢ s'` is the same constant, since `vᵢ ≥ 1`
        refine Or.inr (Or.inr ⟨Q, w, hQ, hwty, (mem_fvo_app _ _ w).2 (Or.inr hwmem),
          fun v hv => ?_⟩)
        obtain ⟨y, hy, hyw, hr1⟩ := hred v hv
        obtain ⟨u, hu, hufree, hr⟩ :=
          numeral_app (v i) (.lam y (iterApp (.var α) (.var w) (Q v)))
        have hwin : w ∈ freeVarOccurrences (.lam y (iterApp (.var α) (.var w) (Q v))) :=
          (mem_fvo_lam _ _ _).2 ⟨(mem_fvo_iterApp _ _ _ _).2 (Or.inr (by simp)),
            fun h => hyw h.symm⟩
        refine ⟨u, hu, fun h => hufree (h ▸ hwin), ?_⟩
        rw [happ]
        refine .trans (.app (ReducesTo.rfl' _) hr1) (.trans hr (.lam u ?_))
        obtain ⟨m, hm⟩ : ∃ m, v i = m + 1 := ⟨v i - 1, by have := hv i; omega⟩
        rw [hm]
        exact iter_const (Q v) (var_ne_of_ty (by rw [hα_ty, hy]; decide))
          (fun h => hyw h.symm) _ m

theorem chain_classified (hFs_ty : ∀ i, (Fs i).ty = Ty.nu)
    (hFs_inj : Function.Injective Fs) (hα_ty : α.ty = Ty.endo) :
    ∀ {z : Var} {body : Term}, IsBasicType00Chain (List.ofFn Fs) α z body →
      ChainClassified Fs α body
  | _, _, .base z hz => by
      refine ⟨fun _ => 0, z, .const 0, hz, by simp, fun v _ => ?_⟩
      rw [numSubst_var hFs_ty v (by rw [hz]; exact ty_zero_ne_nu)]
      exact ReducesTo.rfl' _
  | _, _, @IsBasicType00Chain.step _ _ _ s₁ rest hb hc => by
      obtain ⟨P', w', hP', hw'ty, hw'mem, hred'⟩ := chain_classified hFs_ty hFs_inj hα_ty hc
      have hcong : ∀ v, (∀ i, v i ≠ 0) →
          ReducesTo (substMany (.app s₁ rest) (numSubst Fs v))
            (.app (substMany s₁ (numSubst Fs v)) (iterApp (.var α) (.var w') (P' v))) := by
        intro v hv
        rw [substMany_app]
        exact .app (ReducesTo.rfl' _) (hred' v hv)
      rcases basic_classified hFs_ty hFs_inj hα_ty hb with rfl | ⟨Q, hQ, hred⟩ |
          ⟨Q, w, hQ, hwty, hwmem, hred⟩
      · refine ⟨fun v => P' v + 1, w', .add hP' (.const 1), hw'ty,
          (mem_fvo_app _ _ _).2 (Or.inr hw'mem), fun v hv => ?_⟩
        have := hcong v hv
        rwa [numSubst_var hFs_ty v (by rw [hα_ty]; exact ty_endo_ne_nu)] at this
      · refine ⟨fun v => Q v + P' v, w', .add hQ hP', hw'ty,
          (mem_fvo_app _ _ _).2 (Or.inr hw'mem), fun v hv => ?_⟩
        refine .trans (hcong v hv) (.trans (.app (hred v hv) (ReducesTo.rfl' _)) ?_)
        have hβ := ReducesTo.beta z0 (iterApp (.var α) (.var z0) (Q v))
          (iterApp (.var α) (.var w') (P' v))
        rwa [subst_iterApp, subst_var, if_neg (var_ne_of_ty (by rw [hα_ty]; decide)),
          subst_var, if_pos rfl, iterApp_add] at hβ
      · refine ⟨Q, w, hQ, hwty, (mem_fvo_app _ _ _).2 (Or.inl hwmem), fun v hv => ?_⟩
        obtain ⟨y, hy, hyw, hr⟩ := hred v hv
        refine .trans (hcong v hv) (.trans (.app hr (ReducesTo.rfl' _)) ?_)
        have hβ := ReducesTo.beta y (iterApp (.var α) (.var w) (Q v))
          (iterApp (.var α) (.var w') (P' v))
        rwa [subst_iterApp, subst_var, if_neg (var_ne_of_ty (by rw [hα_ty, hy]; decide)),
          subst_var, if_neg (fun h => hyw h.symm)] at hβ

end

/-- **Milestone 3** (`subterm_polynomial_lemma`, p. 114, lines 14–22). -/
theorem subterm_polynomial_lemma
    (k : Nat) (Fs : Fin k → Var) (α : Var)
    (hFs_ty : ∀ i : Fin k, (Fs i).ty = Ty.nu)
    (hFs_inj : Function.Injective Fs)
    (hα_ty : α.ty = Ty.endo)
    (s : Term)
    (hs : IsType00Subterm (List.ofFn Fs) α s) :
    s = .var α ∨
    ∃ (P : (Fin k → Nat) → Nat) (z : Var),
      IsPolynomial P ∧
      z.ty = .zero ∧
      ∀ v : Fin k → Nat,
        (∀ i : Fin k, v i ≠ 0) →
        ∃ y : Var,
          y.ty = .zero ∧
          (z = y ∨ z ∈ freeVars s) ∧
          ReducesTo
            (substMany s ((List.finRange k).map (fun i => (Fs i, churchNumeral (v i)))))
            (.lam y (iterApp (.var α) (.var z) (P v))) := by
  rcases type00_classified hFs_ty hFs_inj hα_ty hs with h | ⟨P, hP, hred⟩ |
      ⟨P, w, hP, hwty, hwmem, hred⟩
  · exact Or.inl h
  · exact Or.inr ⟨P, z0, hP, rfl, fun v hv => ⟨z0, rfl, Or.inl rfl, hred v hv⟩⟩
  · refine Or.inr ⟨P, w, hP, hwty, fun v hv => ?_⟩
    obtain ⟨y, hy, _, hr⟩ := hred v hv
    exact ⟨y, hy, Or.inr ((mem_freeVars_iff s w).2 hwmem), hr⟩

end Schwichtenberg1976V2.Proofs
